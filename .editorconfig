root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Java : style AOSP de google-java-format (4 espaces), appliqué par Spotless.
[*.java]
indent_size = 4

[*.{py,properties}]
indent_size = 4

# pom.xml : tabulations, comme le produit start.spring.io.
[pom.xml]
indent_style = tab

[*.cmd]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
